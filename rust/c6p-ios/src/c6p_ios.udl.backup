namespace c6p_ios {
    // Version info
    string version();

    // Identity functions
    [Throws=C6pError]
    DeviceIdentity generate_identity();

    [Throws=C6pError]
    SignedPrekey generate_signed_prekey(DeviceIdentity identity);

    [Throws=C6pError]
    OneTimePrekey generate_one_time_prekey();

    [Throws=C6pError]
    bytes compute_device_id(bytes ed25519_pub);

    [Throws=C6pError]
    string compute_fingerprint(bytes ed25519_pub);

    [Throws=C6pError]
    void validate_bundle(PrekeyBundle bundle);

    // Handshake functions
    [Throws=C6pError]
    HandshakeOffer create_offer(
        DeviceIdentity initiator_identity,
        PrekeyBundle responder_bundle
    );

    [Throws=C6pError]
    HandshakeAccept accept_offer(
        DeviceIdentity responder_identity,
        SignedPrekey responder_spk,
        OneTimePrekey? responder_otp,
        bytes offer_bytes
    );

    [Throws=C6pError]
    SessionKeys verify_accept(
        HandshakeOffer offer,
        bytes accept_bytes
    );

    [Throws=C6pError]
    SessionKeys get_session_keys_responder(
        HandshakeAccept accept
    );

    // Utility functions
    string bytes_to_hex(bytes data);

    [Throws=C6pError]
    bytes hex_to_bytes(string hex);

    [Throws=C6pError]
    bytes random_bytes(u32 length);
};

// ============================================================================
// Error Types
// ============================================================================

[Error]
enum C6pError {
    "InvalidKey",
    "InvalidSignature",
    "InvalidDeviceId",
    "InvalidFingerprint",
    "HandshakeFailed",
    "CryptoError",
    "SessionError",
    "ReplayDetected",
    "CounterExhausted",
    "DecryptionFailed",
    "SerializationError",
    "InvalidInput",
};

// ============================================================================
// Identity Management
// ============================================================================

/// Device identity with Ed25519 (signing) and X25519 (DH) key pairs
dictionary DeviceIdentity {
    bytes device_id;
    bytes identity_priv_ed25519;
    bytes identity_pub_ed25519;
    bytes identity_priv_x25519;
    bytes identity_pub_x25519;
    string fingerprint;
};

/// Signed prekey pair
dictionary SignedPrekey {
    bytes spk_id;
    bytes spk_priv;
    bytes spk_pub;
    bytes spk_sig;
};

/// One-time prekey pair
dictionary OneTimePrekey {
    bytes otp_id;
    bytes otp_priv;
    bytes otp_pub;
};

/// Prekey bundle for publishing
dictionary PrekeyBundle {
    bytes responder_device_id;
    bytes identity_pub_ed25519;
    bytes identity_pub_x25519;
    bytes spk_id;
    bytes spk_pub;
    bytes spk_sig;
    bytes? otp_id;
    bytes? otp_pub;
};

// (Functions moved to namespace above)

// ============================================================================
// Handshake (IslandAccord v1)
// ============================================================================

/// Handshake offer from initiator
dictionary HandshakeOffer {
    bytes session_id;
    bytes initiator_device_id;
    bytes responder_device_id;
    bytes initiator_identity_dh_pub;
    bytes initiator_identity_sig_pub;
    bytes initiator_ephemeral_dh_pub;
    bytes used_spk_id;
    bytes used_spk_pub;
    bytes used_spk_sig;
    bytes? used_otp_id;
    bytes? used_otp_pub;
    bytes transcript_hash;
    bytes kc1;
    bytes offer_signature;
    bytes serialized;
};

/// Handshake accept from responder
dictionary HandshakeAccept {
    bytes session_id;
    bytes kc2;
    bytes accept_signature;
    bytes serialized;
};

/// Session keys after successful handshake
dictionary SessionKeys {
    bytes session_id;
    bytes root_key;
    bytes send_chain_key;
    bytes recv_chain_key;
    bytes session_binding;
};

// (Functions moved to namespace above)

// ============================================================================
// Session Management
// ============================================================================

/// Encrypted message
dictionary EncryptedMessage {
    u64 counter;
    bytes ciphertext;
    bytes tag;
};

/// Session state (opaque, managed by Swift)
interface SessionState {
    /// Create new session from handshake keys
    [Throws=C6pError]
    constructor(SessionKeys keys, boolean is_initiator);

    /// Encrypt outgoing message
    [Throws=C6pError]
    EncryptedMessage encrypt(bytes plaintext);

    /// Decrypt incoming message
    [Throws=C6pError]
    bytes decrypt(EncryptedMessage message);

    /// Get current send counter
    u64 send_counter();

    /// Get current recv expected counter
    u64 recv_expected();

    /// Export session state for persistence
    [Throws=C6pError]
    bytes export_state();

    /// Import session state from persistence
    [Throws=C6pError]
    static SessionState import_state(bytes state_bytes);
};

// ============================================================================
// Utilities
// ============================================================================

