# Server Configuration
HOST=0.0.0.0
PORT=8080

# Database
DATABASE_URL=postgres://convro_app:CHANGE_THIS_PASSWORD@localhost:5432/convro

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_change_this_in_production_min_32_chars
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=2592000

# Logging
RUST_LOG=info,convro_server=debug

# CORS
CORS_ALLOWED_ORIGINS=https://app.convro.app,https://convro.app

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_CLIENT_TIMEOUT=60
